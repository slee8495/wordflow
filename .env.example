# --- Database (Neon Postgres via Vercel Marketplace) ---
# Auto-filled by `vercel env pull` once the project is linked and Neon is provisioned —
# see README. No manual signup needed.
DATABASE_URL=

# --- AI Gateway (chat model, TTS, transcription) ---
# No key needed: when linked to Vercel (`vercel link`), `vercel env pull` also pulls a
# VERCEL_OIDC_TOKEN, which the `ai` package's gateway provider uses automatically.

# --- Bible text sources ---
# Tyndale NLT API — https://api.nlt.to (free for non-commercial use)
NLT_API_KEY=
# No Korean Bible API key needed — Claude renders the Korean 새번역-style text itself,
# grounded in the NLT English text (see src/lib/generateReading.ts).

# --- YouTube Data API v3 (worship/sermon auto-search) ---
YOUTUBE_API_KEY=

# --- Auth.js (NextAuth v5) — Google sign-in ---
# Random secret NextAuth uses to sign session JWTs/cookies — generate with `openssl rand -base64 32`
AUTH_SECRET=
# From a Google Cloud Console OAuth client (Web application type) — see README for exact steps.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe billing ($3.99/mo, 7-day free trial) ---
# Secret key from the Stripe dashboard (Developers -> API keys) — use a test-mode key while
# developing, switch to a live key only once ready to charge real users.
STRIPE_SECRET_KEY=
# Created after adding a webhook endpoint (Developers -> Webhooks) pointing at
# https://<domain>/api/billing/webhook, listening for checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# Price ID for the $3.99/month recurring price (Product catalog -> create a $3.99/mo recurring price).
STRIPE_PRICE_ID=

# --- Admin / comp access ---
# Your own Google account email — the only account allowed to view /admin.
ADMIN_EMAIL=
# Shared secret family members enter once in Settings to get permanent free access.
FAMILY_PASSPHRASE=

# --- Cron / API auth ---
# Random secret; Vercel Cron sends it as `Authorization: Bearer <value>` automatically once set
# as a project env var — see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=
# Shared secret for any non-browser caller of /api/transcribe (mirrors sl_sports' KEYBOARD_API_KEY)
APP_API_KEY=
